{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "buildCommand": "pnpm --filter @bloodsync/shared build && pnpm --filter @bloodsync/web build",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "BLOODSYNC_API_INTERNAL_URL"
        }
      ],
      "functions": {
        "app/api/queues/account-email/route.ts": {
          "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "account-email" }]
        }
      }
    },
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "buildCommand": "pnpm --filter @bloodsync/shared build && pnpm --filter @bloodsync/api db:generate && if [ \"$VERCEL_ENV\" = production ]; then pnpm --filter @bloodsync/api exec prisma migrate deploy; fi && pnpm --filter @bloodsync/api build"
    }
  },
  "rewrites": [
    { "source": "/api/queues/(.*)", "destination": { "service": "api" } },
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [{ "path": "/api/v1/cron/expire-requests", "schedule": "0 3 * * *" }]
}
