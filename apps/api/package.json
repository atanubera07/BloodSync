{
  "name": "@bloodsync/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:coverage": "vitest run src --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "admin:provision": "tsx src/provision-admin.ts"
  },
  "dependencies": {
    "@bloodsync/shared": "workspace:*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.17",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.1.7",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^7.10.1",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
