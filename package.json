{
  "name": "bloodsync",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @bloodsync/api db:generate",
    "db:migrate": "pnpm --filter @bloodsync/api db:migrate"
  }
}
